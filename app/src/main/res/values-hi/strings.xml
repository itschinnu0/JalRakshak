    <!-- Purification Screen Strings -->
    <string name="purification_title">Multi-Barrier Shuddhikaran Pipeline</string>
    <string name="purification_subtitle">10-Stage Treatment &amp; Monitoring Sequence</string>
    <string name="purification_select_stage_hint">Kisi bhi stage par tap karke uski details dekhein.</string>
    <string name="purification_stage_detail_title">Stage Details aur Jankari</string>
